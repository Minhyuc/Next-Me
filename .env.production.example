# 이 파일은 예시입니다. 실제 값 입력 후 서버 환경 변수 또는 안전한 비밀 파일로 관리하세요.
# 실제 비밀값이 든 .env는 Git에 커밋하지 않습니다.

# 모든 서비스가 같은 MySQL 서버와 계정을 사용하는 가비아 단일 서버 예시
LOGIN_DB_URL=jdbc:mysql://localhost:3306/NMLoginData
USER_DB_URL=jdbc:mysql://localhost:3306/NMUserData
AI_CHAT_DB_URL=jdbc:mysql://localhost:3306/NMAiChatData
ROUTINE_DB_URL=jdbc:mysql://localhost:3306/NMRoutineData
PERSONAL_COLOR_DB_URL=jdbc:mysql://localhost:3306/NMPersonalColorData
DB_USERNAME=nextme
MYSQL_PASSWORD=CHANGE_ME

# 같은 가비아 서버에서 모든 Spring Boot 프로세스를 실행하면 localhost를 유지합니다.
LOGIN_SERVICE_URL=http://localhost:8081
USER_SERVICE_URL=http://localhost:8082
AI_CHAT_SERVICE_URL=http://localhost:8083
ROUTINE_SERVICE_URL=http://localhost:8084
PERSONAL_COLOR_SERVICE_URL=http://localhost:8085

# 인증과 외부 서비스 비밀값
CREATE_JWT=CHANGE_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_BYTES
OPENAI_API_KEY=CHANGE_ME
OPENAI_MODEL=gpt-4o-mini
OPENAI_RESPONSES_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_ENDPOINT=https://api.openai.com/v1/chat/completions
MAIL_USERNAME=CHANGE_ME
GOOGLE_APP_PASSWORD=CHANGE_ME

# 서비스별 포트(기본값과 같다면 생략 가능)
GATEWAY_PORT=8080
LOGIN_SERVICE_PORT=8081
USER_SERVICE_PORT=8082
AI_CHAT_SERVICE_PORT=8083
ROUTINE_SERVICE_PORT=8084
PERSONAL_COLOR_SERVICE_PORT=8085

# DB 계정이 서비스별로 다를 때만 아래 값을 추가합니다.
# LOGIN_DB_USERNAME=nextme_login
# LOGIN_DB_PASSWORD=CHANGE_ME
# USER_DB_USERNAME=nextme_user
# USER_DB_PASSWORD=CHANGE_ME
# AI_CHAT_DB_USERNAME=nextme_ai_chat
# AI_CHAT_DB_PASSWORD=CHANGE_ME
# ROUTINE_DB_USERNAME=nextme_routine
# ROUTINE_DB_PASSWORD=CHANGE_ME
# PERSONAL_COLOR_DB_USERNAME=nextme_personal_color
# PERSONAL_COLOR_DB_PASSWORD=CHANGE_ME
